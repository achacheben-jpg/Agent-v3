# Clé API Anthropic (à créer sur https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Mot de passe pour ouvrir l'application (choisissez-le vous-même)
APP_PASSWORD=changez-moi

# Prénom utilisé par l'assistant pour s'adresser à vous (optionnel)
USER_NAME=Ben

# Port du serveur (laisser tel quel en général)
PORT=3000
